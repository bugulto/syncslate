# Shared local URLs
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# Browser-visible web configuration
# Only non-secret values may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend-only runtime configuration
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend-only database and authentication secrets
# Never expose these with a NEXT_PUBLIC_ prefix.
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INVITE_TOKEN_PEPPER=
GUEST_JWT_SECRET=

# Collaboration tuning
YJS_UPDATE_BATCH_MS=400
