# Currently validated API runtime settings
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Database and Supabase authentication used by the API.
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Reserved for future backend-only administration; not currently validated.
SUPABASE_SERVICE_ROLE_KEY=

# Required invitation-token hashing secret. Use at least 32 random characters.
INVITE_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Required short-lived candidate credential settings.
GUEST_JWT_SECRET=replace-with-at-least-32-random-characters
GUEST_JWT_TTL_SECONDS=1800

# Realtime room connection timing (milliseconds).
ROOM_AUTH_TIMEOUT_MS=5000
ROOM_HEARTBEAT_INTERVAL_MS=30000
ROOM_DISCONNECT_GRACE_MS=10000

YJS_UPDATE_BATCH_MS=400
