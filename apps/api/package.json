{
  "name": "@syncslate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "pnpm --filter @syncslate/contracts build && pnpm --filter @syncslate/database build && tsx watch --env-file-if-exists=.env src/server.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run src/modules",
    "test:unit": "vitest run src/config",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@syncslate/contracts": "workspace:*",
    "@syncslate/database": "workspace:*",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
