{
  "name": "@syncslate/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:check": "tsx --env-file-if-exists=../../apps/api/.env src/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=../../apps/api/.env src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../apps/api/.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@syncslate/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
